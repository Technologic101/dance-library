{
  "name": "dance-library",
  "productName": "Dance Library",
  "version": "0.0.1",
  "private": true,
  "description": "Desktop catalog for a personal dance video library. Stores references and metadata only.",
  "author": "Dance Library contributors",
  "license": "UNLICENSED",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install-binaries": "node scripts/install-runtime-binaries.cjs",
    "dev": "node scripts/install-runtime-binaries.cjs && electron-forge start",
    "start": "node scripts/install-runtime-binaries.cjs && electron-forge start",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/install-runtime-binaries.cjs && vitest run",
    "test:watch": "vitest",
    "package": "node scripts/install-runtime-binaries.cjs && electron-forge package",
    "make": "node scripts/install-runtime-binaries.cjs && electron-forge make"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^45.2.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.7",
    "vitest": "^4.0.0"
  }
}
